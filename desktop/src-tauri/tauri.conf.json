{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "InfinityCraft",
  "version": "1.0.2",
  "identifier": "app.infinitycraft.launcher",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "InfinityCraft",
        "width": 1060,
        "height": 680,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "center": true,
        "decorations": false,
        "shadow": true,
        "backgroundColor": "#0b0d12"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDU4QkE0MDQxNDUxOUUzQTQKUldTazR4bEZRVUM2V0tFa1EzRWdYYXBGT2RYOGxVd3RNVDY5NWxiM0ZpVkVMdXMwVFdTRHBsTFAK",
      "endpoints": [
        "https://raw.githubusercontent.com/infinitycraft3-3-5a/infinitycraft-launcher/main/updater.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "resources": [],
    "shortDescription": "InfinityCraft Launcher",
    "longDescription": "Official InfinityCraft launcher (World of Warcraft 3.3.5a private server).",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["French", "English"],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}


